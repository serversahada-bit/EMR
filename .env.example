# Salin menjadi .env.local lalu isi sesuai server Anda.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dataslu

# Sync Google Sheet. Buat di Google Cloud Console → APIs & Services →
# Credentials → Create API key, lalu Enable "Google Sheets API" pada project
# yang sama. Gratis, tanpa kartu kredit.
#
# API key hanya bisa membaca spreadsheet yang terbuka untuk umum
# ("Anyone with the link"). Untuk sheet tertutup perlu service account.
GOOGLE_SHEETS_API_KEY=

# Login laporan. Akun disimpan di tabel emr_user (dibuat otomatis);
# akun awal admin / admin wajib diganti saat login pertama, lalu user
# lain ditambah dari menu Setingan user.
#
# Kunci tanda tangan cookie sesi. Buat dengan: openssl rand -base64 32
# Bila kosong, kunci acak dibuat sekali di berkas .emr-secret. Di server
# berbasis container (mis. Coolify) berkas itu hilang tiap deploy, jadi
# ISI variabel ini supaya user tidak perlu login ulang setiap deploy.
AUTH_SECRET=
